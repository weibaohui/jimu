#!/bin/bash
# ─────────────────────────────────────────────────────
#  Jimu 开发环境（Portless 版）
#  提供稳定命名 URL + HTTPS
#
#  用法:
#    ./dev-portless            # 完整启动（可能需要 sudo 密码）
#    ./dev-portless --no-sudo  # 使用 8443 端口（不需要 sudo）
# ─────────────────────────────────────────────────────

set -e

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
BLUE='\033[0;34m'; NC='\033[0m'
print_info() { echo -e "${GREEN}[INFO]${NC} $1"; }
print_error() { echo -e "${RED}[ERROR]${NC} $1"; }
print_step() { echo -e "${BLUE}==>${NC} $1"; }

cleanup() {
    print_info "清理进程..."
    kill $BACKEND_PID 2>/dev/null || true
    kill $FRONTEND_PID 2>/dev/null || true
    portless proxy stop 2>/dev/null || true
    exit 0
}
trap cleanup EXIT INT TERM

NO_SUDO=false
[ "$1" = "--no-sudo" ] && NO_SUDO=true

# 检查依赖
for cmd in portless cargo node; do
    command -v $cmd &>/dev/null || { print_error "$cmd 未安装"; exit 1; }
done

# 安装依赖
print_step "安装依赖..."
(cd host/backend && cargo check &>/dev/null || cargo build)
(cd host/frontend && [ ! -d node_modules ] && npm install || true)

# 启动 Portless 代理
print_step "启动 Portless 代理..."
if [ "$NO_SUDO" = true ]; then
    portless proxy start --port 8443 &
else
    sudo portless proxy start &
fi
sleep 2

# 启动后端（自动读取 PORT 环境变量，portless 会注入）
print_step "启动后端: https://jimu-api.localhost..."
cd host/backend
export DATABASE_URL=sqlite:./host.db
export PLUGINS_DIR=../../plugins
export LOG_LEVEL=info
cargo run &
BACKEND_PID=$!
cd ../..
sleep 4

# 注册后端别名（让 portless 将 jimu-api.localhost 指向后端）
portless alias jimu-api localhost:3000 2>/dev/null || true

# 启动前端（通过 portless 运行）
print_step "启动前端: https://jimu-app.localhost..."
cd host/frontend
portless jimu-app vite &
FRONTEND_PID=$!
cd ../..
sleep 3

# 显示访问信息
echo ""
echo "============================================"
echo "  Jimu 开发环境（Portless）"
echo "============================================"
echo ""
echo -e "${GREEN}前端:${NC}  https://jimu-app.localhost"
echo -e "${GREEN}后端:${NC}  https://jimu-api.localhost"
echo ""
echo "命令参考:"
echo "  portless list        查看所有路由"
echo "  portless proxy stop  停止代理"
echo ""
echo "按 Ctrl+C 停止所有服务"
echo "============================================"
echo ""

wait
