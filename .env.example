# 宿主系统环境变量配置

# 服务器配置
SERVER_ADDRESS=0.0.0.0:3000

# 数据库配置
# SQLite (默认)
DATABASE_URL=sqlite:./host.db

# PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/database

# MySQL
# DATABASE_URL=mysql://user:password@localhost:3306/database

# 插件目录
PLUGINS_DIR=./plugins

# 日志级别
# 可选值: error, warn, info, debug, trace
LOG_LEVEL=info

# 前端开发服务器端口
FRONTEND_PORT=5173

# 应用配置
APP_NAME=宿主系统
APP_VERSION=0.1.0

# 其他配置
# RUST_LOG=debug
